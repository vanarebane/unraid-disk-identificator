<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "disk.identificator">
<!ENTITY author    "vanarebane">
<!ENTITY version   "2026.10.10">
<!ENTITY md5       "110e970dc2d077e3270ef1224da5edce">
<!ENTITY github    "vanarebane/unraid-disk-identificator">
<!ENTITY branch    "main">
<!ENTITY pluginURL "https://raw.githubusercontent.com/&github;/&branch;/&name;.plg">
<!ENTITY packageURL "https://raw.githubusercontent.com/&github;/&branch;/archive/&name;-&version;-x86_64-1.txz">
<!ENTITY plugdir   "/usr/local/emhttp/plugins/&name;">
<!ENTITY cfgdir    "/boot/config/plugins/&name;">
]>

<PLUGIN name="&name;"
        author="&author;"
        version="&version;"
        launch="Settings/DiskIdentificator"
        pluginURL="&pluginURL;"
        support="https://github.com/&github;/issues"
        icon="lightbulb-o"
        min="6.12.0">

<CHANGES>
### 2026.10.10
- Initial release: identification LED buttons on Dashboard and Main, slot to LED remapping, LED colour per enclosure.
- Location label per slot, shown next to the ID button.
- Turn off indicator timer (never, 10 s, 20 s, 30 s, 5 min, 10 min).
- Bundles Broadcom sas3ircu P16 (SAS3 HBAs) and sas2ircu P20 (SAS2 HBAs).
</CHANGES>

<!-- Plugin package. Includes /usr/local/bin/sas3ircu (SAS3 HBAs) and /usr/local/bin/sas2ircu (SAS2 HBAs). -->
<FILE Name="&cfgdir;/&name;-&version;-x86_64-1.txz" Run="upgradepkg --install-new">
<URL>&packageURL;</URL>
<MD5>&md5;</MD5>
</FILE>

<!-- Post install -->
<FILE Run="/bin/bash">
<INLINE>
# remove older package versions from the flash drive
find &cfgdir; -maxdepth 1 -name '&name;-*.txz' ! -name '&name;-&version;-x86_64-1.txz' -delete

# start with a fresh controller scan
rm -rf /tmp/&name;

echo ""
echo "----------------------------------------------------"
echo " &name; has been installed."
echo " Version: &version;"
echo " Settings: Settings > User Utilities > Disk Identificator"
echo "----------------------------------------------------"
echo ""
</INLINE>
</FILE>

<!-- Remove -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
removepkg &name;-&version;-x86_64-1
rm -rf &plugdir; /tmp/&name;
rm -f &cfgdir;/*.txz
echo ""
echo "&name; has been removed. Settings are kept in &cfgdir;/settings.json"
echo ""
</INLINE>
</FILE>

</PLUGIN>
